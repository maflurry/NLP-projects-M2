        "def query_preprocessing(query):\n",
        "  # Preprocessing function for the different queries\n",
        "  words = query.split()\n",
        "  processed_query = [stemmer.stem(word) for word in words if word not in stopwords]\n",
        "  return processed_query"
      ],
      "metadata": {
        "id": "hpLYKdH4GVka"
      },
      "execution_count": null,
