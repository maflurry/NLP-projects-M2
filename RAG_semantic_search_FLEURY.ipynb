    {
      "cell_type": "code",
      "source": [
        "true_positive_basis = set(correct_outputs) - set(potential_queries_indices)\n",
        "len(list(true_positive_basis))"
      ],
      "metadata": {
        "id": "cdXILX4yMgV6",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "5f7150a4-6235-4306-8437-e5881cca59e0"
