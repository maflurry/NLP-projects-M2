    {
      "cell_type": "code",
      "source": [
        "false_examples = resample(df_q.loc[~df_q['qid'].isin(true_positive_basis), 'qid'].values,\n",
        "                          n_samples=10000,\n",
        "                          replace=False)\n",
        "print(len(false_examples))\n",
        "# sélectionne les questions dont les identifiants (qid) ne figurent pas dans true_positive_basis, donc\n",
        "# on obtient uniquement les qid qui ne sont pas des duplicatas connus (ce qui les rend \"négatifs\").\n",
        "# resample: sélectionne 10 000 qid parmi les exemples négatifs identifiés.\n",
        "# Ces questions vont servir d'exemples négatifs pour évaluer si le système de recherche peut distinguer les questions pertinentes (duplicatas) des non-pertinentes.\n",
        "\n",
        "all_ids = np.concatenate((list(true_positive_basis), false_examples)) # ids of the chunks for the vdb\n",
        "print(len(all_ids))"
      ],
