    {
      "cell_type": "code",
      "source": [
        "def hits(list_labels):\n",
        "  if 1 in list_labels:\n",
        "    return 1\n",
        "  return 0"
      ],
      "metadata": {
        "id": "e7ujuFXaMnCR"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def ap(list_labels):\n",
        "  # compute average precision : https://www.evidentlyai.com/ranking-metrics/mean-average-precision-map\n",
        "  labels = 0\n",
        "  precisions = []\n",
        "  for i,label in enumerate(list_labels):\n",
        "    if label == 1:\n",
        "      labels += 1\n",
        "      precisions.append(labels / (i+1))\n",
        "  if labels == 0:\n",
        "    return 0\n",
        "  return sum(precisions)/labels"
      ],
      "metadata": {
        "id": "9iLovUf7MyK_"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def compute_metrics(list_list_labels):\n",
        "  hits_list = [hits(l) for l in list_list_labels]\n",
        "  ap_list = [ap(l) for l in list_list_labels]\n",
        "  return {'hit_rate': sum(hits_list)/len(hits_list), 'map': sum(ap_list)/len(ap_list)}"
      ],
      "metadata": {
        "id": "5L8HaX0t2Xmh"
      },
      "execution_count": null,
      "outputs": []
    },
